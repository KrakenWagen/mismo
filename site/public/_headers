# Cache rules for the static site (Cloudflare reads this file from the assets folder).
#
# HTML keeps the default, `max-age=0, must-revalidate`: browsers check it on every visit, so a new
# deploy shows at once.

# Built files: their names carry a hash of their content, so a name never changes meaning.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images under fixed names: a day fresh, then refreshed in the background.
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-32.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
