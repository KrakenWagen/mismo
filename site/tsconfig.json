{
  "extends": "../configs/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "declaration": false,
    "declarationMap": false,
    // TanStack Start says this option leaks server modules into the client bundle.
    "verbatimModuleSyntax": false,
    // shadcn's components import from "@/".
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "mdx.config.ts", "highlight.plugin.ts"]
}
