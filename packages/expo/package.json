{
  "name": "@mismo/expo",
  "version": "0.1.0-beta.1",
  "description": "mismo for Expo Router: run shared screens and routes on native, and define routes in Expo Router's format.",
  "keywords": [
    "mismo",
    "expo",
    "expo-router",
    "react-native",
    "routes"
  ],
  "homepage": "https://mismo.dev",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.tsx",
    "./metro": "./src/metro.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-declarations.mjs dist",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@mismo/core": "workspace:^"
  },
  "peerDependencies": {
    "expo-router": ">=58 <59",
    "react": ">=19",
    "react-native": ">=0.79"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "expo-router": "~58.0.29",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./metro": {
        "types": "./dist/metro.d.ts",
        "default": "./dist/metro.js"
      }
    }
  }
}
