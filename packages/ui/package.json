{
  "name": "@mismo/ui",
  "version": "0.1.0-beta.1",
  "description": "React Strict DOM with Tailwind's className, on web and native. Nothing extra in your web bundle.",
  "keywords": [
    "react",
    "react-native",
    "react-strict-dom",
    "tailwind",
    "tailwindcss",
    "uniwind",
    "expo",
    "cross-platform",
    "universal",
    "ui"
  ],
  "license": "MIT",
  "homepage": "https://mismo.dev",
  "bugs": {
    "url": "https://github.com/KrakenWagen/mismo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrakenWagen/mismo.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "integrations",
    "css",
    "strict-dom",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./strict-dom": "./strict-dom/index.js",
    "./strict-dom/runtime": "./strict-dom/runtime.js",
    "./tailwind.css": "./css/tailwind.css",
    "./babel": "./integrations/babel.cjs",
    "./postcss": "./integrations/postcss.cjs",
    "./next": "./integrations/next.cjs",
    "./vite": "./integrations/vite.cjs",
    "./metro": "./integrations/metro.cjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "react-native": {
          "types": "./dist/index.native.d.ts",
          "default": "./dist/index.native.js"
        },
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./strict-dom": "./strict-dom/index.js",
      "./strict-dom/runtime": "./strict-dom/runtime.js",
      "./tailwind.css": "./css/tailwind.css",
      "./babel": "./integrations/babel.cjs",
      "./postcss": "./integrations/postcss.cjs",
      "./next": "./integrations/next.cjs",
      "./vite": "./integrations/vite.cjs",
      "./metro": "./integrations/metro.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.32",
    "react-strict-dom": "^0.0.55",
    "tailwindcss": "^4.3.3",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5",
    "vite": "^8.3.4",
    "vite-plugin-babel": "^1.7.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": ">=5",
    "vite": ">=8",
    "vite-plugin-babel": ">=1.3"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-babel": {
      "optional": true
    }
  }
}
