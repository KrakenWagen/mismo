{
  "name": "@mismo/tanstack",
  "version": "0.1.0-beta.1",
  "description": "mismo for TanStack Start and TanStack Router: run shared screens and routes in a TanStack app.",
  "keywords": [
    "mismo",
    "tanstack",
    "tanstack-router",
    "tanstack-start",
    "routes"
  ],
  "homepage": "https://mismo.dev",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.tsx"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@mismo/core": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.160",
    "react": ">=19"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@types/react": "^19.3.0",
    "react": "19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    }
  }
}
