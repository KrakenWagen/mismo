{
  "name": "@mismo/react-navigation",
  "version": "0.1.0-beta.1",
  "description": "mismo for React Navigation: run shared screens and routes in a React Native app on React Navigation.",
  "keywords": [
    "mismo",
    "react-navigation",
    "react-native",
    "routes"
  ],
  "homepage": "https://mismo.dev",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.tsx",
    "./metro": "./src/metro.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@mismo/core": "workspace:^"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7.5 <8",
    "@react-navigation/native-stack": ">=7 <8",
    "react": ">=19",
    "react-native": ">=0.79"
  },
  "devDependencies": {
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7",
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./metro": {
        "types": "./dist/metro.d.ts",
        "default": "./dist/metro.js"
      }
    }
  }
}
