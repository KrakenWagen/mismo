{
  "name": "@mismo/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "demo.mismo.dev: the starter's notes app, on the web and on phones through Expo Go.",
  "scripts": {
    "build": "node build.ts",
