{
  // The published build: JavaScript and declarations in dist, the source's .ts imports rewritten to .js.
  // @mismo/core is compiled against its own build, so this package's declarations import its types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@mismo/core": ["../core/dist/runtime/index.d.ts"],
      "@mismo/core/config": ["../core/dist/config/index.d.ts"],
      "@mismo/core/adapter": ["../core/dist/adapter/index.d.ts"],
      "@mismo/core/generate": ["../core/dist/generate/index.d.ts"],
      "@mismo/core/vite": ["../core/dist/integrations/vite.d.ts"],
      "@mismo/core/contract": ["../core/dist/runtime/contract.d.ts"]
    }
  },
  "include": ["src"]
}
