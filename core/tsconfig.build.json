{
  // The published build: JavaScript and declarations in dist, the source's .ts imports rewritten to .js.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src"]
}
