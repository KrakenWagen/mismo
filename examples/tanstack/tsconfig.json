{
  "extends": "../../configs/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "vite/client"],
    "declaration": false,
    "declarationMap": false,
    // TanStack Start says this option leaks server modules into the client bundle.
    "verbatimModuleSyntax": false
  },
  "include": ["src", "*.ts"]
}
